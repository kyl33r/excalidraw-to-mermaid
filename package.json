{
  "name": "excali2md",
  "version": "0.1.0",
  "description": "Deterministic Excalidraw-to-Mermaid converter",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "bin": {
    "excali2md": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "convert": "node dist/cli.js",
    "test": "vitest run test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "@types/node": "25.9.5",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
